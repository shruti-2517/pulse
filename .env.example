# Application
PROJECT_NAME="Pulse"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server
API_HOST="0.0.0.0"
API_PORT=8000

# PostgreSQL / TimescaleDB
POSTGRES_USER="pulse_user"
POSTGRES_PASSWORD="pulse_secure_password"
POSTGRES_DB="pulse_db"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://pulse_user:pulse_secure_password@postgres:5432/pulse_db"

# Redis
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://redis:6379/0"

# Security & JWT
JWT_SECRET_KEY="pulse_dev_insecure_secret_key_change_in_production_min_32_chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'
